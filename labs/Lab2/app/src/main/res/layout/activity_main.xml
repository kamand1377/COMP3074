<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/logo_description"
        android:src="@drawable/ic_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textOutput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="0"
        android:textSize="48sp"
        app:layout_constraintTop_toBottomOf="@id/imageLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 1: minus and plus -->
    <Button
        android:id="@+id/buttonSubtract"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/subtract"
        android:textSize="22sp"
        android:textColor="@color/button_text"
        app:backgroundTint="@color/counter_green"
        app:layout_constraintTop_toBottomOf="@id/textOutput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonAdd" />

    <Button
        android:id="@+id/buttonAdd"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:text="@string/add"
        android:textSize="22sp"
        android:textColor="@color/button_text"
        app:backgroundTint="@color/counter_green"
        app:layout_constraintTop_toTopOf="@id/buttonSubtract"
        app:layout_constraintStart_toEndOf="@id/buttonSubtract"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 2: reset and step -->
    <Button
        android:id="@+id/buttonReset"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/reset"
        android:textColor="@color/button_text"
        app:backgroundTint="@color/reset_red"
        app:layout_constraintTop_toBottomOf="@id/buttonSubtract"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonStep" />

    <Button
        android:id="@+id/buttonStep"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:text="@string/step"
        android:textColor="@color/button_text"
        app:backgroundTint="@color/step_green"
        app:layout_constraintTop_toTopOf="@id/buttonReset"
        app:layout_constraintStart_toEndOf="@id/buttonReset"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>